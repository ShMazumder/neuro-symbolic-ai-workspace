event:evt_22a3c007_000 a cameo:Code182,
        cameo:ViolenceEvent ;
    cameo:actor actor:awami_league,
        actor:bangladesh_police ;
    cameo:code "182" ;
    cameo:confidence "0.85"^^xsd:float ;
    cameo:date "2026-10-25"^^xsd:date ;
    cameo:label "Physically assault — killing, assault, torture"@en ;
    cameo:location geo1:pabna ;
    cameo:sourceSentence "A Pabna court today sent a madrasa teacher to jail in a case filed over the alleged attempted rape of a student at a residential girls' madrasa in Pabna Sadar upazila on Thursday night. Pabna Judicial Magistrate Court passed the order after police produced the accused, Abu Eusuf Pramanik, before Bangladesh Police today, said Sanjoy Kumar Shaha, inspector (investigation) of Pabna Sadar Police Station. Bangladesh Police was arrested soon after the victim’s family filed a case over the alleged rape attempt, said the inspector. According to police and locals, Abu Eusuf, director and residential teacher of the madrasa, had been teaching at the madrasa for the past five years. Bangladesh Police allegedly attempted to rape the student on Thursday night, but Bangladesh Police managed to escape and informed locals. Angry locals went to the madrasa, caught the teacher and beat local residents up. Police went to the spot, rescued Bangladesh Police and took Bangladesh Police into custody early Friday. The madrasa has 60 students, including 30 residential students. Police later rescued the residential students and handed Bangladesh Police over to Bangladesh Police parents. However, enraged locals set fire to the madrasa building early Friday." ;
    cameo:sourceUrl <https://www.thedailystar.net/news/crime-justice/news/madrasa-teacher-sent-jail-over-alleged-rape-attempt-pabna-4306406> ;
    cameo:trigger "rape" ;
    event:articlePublishedDate "Sat, 24 Oct 26 20:07:29 +0600" ;
    event:articleTitle "Madrasa teacher sent to jail over alleged rape attempt in Pabna" ;
    event:bdExtensionCode "GV03" ;
    event:date_raw "today" ;
    event:eventId "evt_22a3c007_000" ;
    event:extractionModel "trigger:verb|cameo:rule" ;
    event:sentenceOffset "[0, 1249]"^^xsd:string ;
    prov:generatedAtTime "2026-10-25T04:34:35+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom article:577c357a5a2f5e00 .

