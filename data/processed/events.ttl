event:evt_4153e389_000 a cameo:Code182,
        cameo:ViolenceEvent ;
    cameo:actor actor:awami_league,
        actor:bangladesh_police ;
    cameo:code "182" ;
    cameo:confidence "0.7"^^xsd:float ;
    cameo:date "2026-10-24"^^xsd:date ;
    cameo:label "Physically assault — killing, assault, torture"@en ;
    cameo:location geo1:police ;
    cameo:sourceSentence "Police recovered the body of a local union parishad (UP) member from Bangladesh Police second wife's house at Joanpur in Naldanga upazila early yesterday. The deceased, Abdul Alim, 40, a member of Ward No 1 under Madhanagar UP, was son of late Ashraful Islam of West Madhanagar village in the upazila. The law enforcers also rescued Alim's second wife Rima Begum, who sustained stab injuries, and admitted Bangladesh Police to Rajshahi Medical College Hospital. Madhanagar UP Chairman Abdul Jabbar said Alim went to Bangladesh Police second wife Rima's house on Monday evening. After having After dinner, the couple locked in a quarrel over different family issues at the dead of night. Later, hearing Rima's screams, Rima mother Eleka Begum entered the room and found the duo lying in the floor unconscious and informed the police, Eleka Begum said. Being informed, Naldanga police recovered Alim's body and sent Bangladesh Police to the hospital morgue for autopsy. Deceased's younger brother Ashiq Ali alleged that Bangladesh Police brother was killed in a planned manner and demanded proper investigation in this regard. Officer in Charge of Naldanga Police Station Shafiqul Islam said the reason behind the death will be clear once the autopsy is done." ;
    cameo:sourceUrl <https://www.thedailystar.net/news/bangladesh/crime-justice/news/natore-member-found-dead-wife-injured-3069041> ;
    cameo:trigger "stab" ;
    event:articlePublishedDate "Tue, 12 Jul 22 18:00:00 +0600" ;
    event:articleTitle "Natore UP member found dead, wife injured" ;
    event:date_raw "yesterday" ;
    event:eventId "evt_4153e389_000" ;
    event:extractionModel "trigger:verb|cameo:rule" ;
    event:sentenceOffset "[0, 1257]"^^xsd:string ;
    prov:generatedAtTime "2026-10-25T04:34:35+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom article:49fca200764f6c26 .

