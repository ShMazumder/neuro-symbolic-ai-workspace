event:evt_a05c42c8_000 a cameo:Code182,
        cameo:ViolenceEvent ;
    cameo:actor actor:awami_league,
        actor:bangladesh_chhatra_league,
        actor:bangladesh_police,
        actor:cid ;
    cameo:code "182" ;
    cameo:confidence "0.7"^^xsd:float ;
    cameo:date "None" ;
    cameo:label "Physically assault — killing, assault, torture"@en ;
    cameo:location geo1:two ;
    cameo:sourceSentence "Two policemen were injured after a police van came under attack during a procession allegedly organised by Jubo League, whose activities are banned, and banned organisation Chhatra League in Gopalganj. Two police personnel, including Sub-Inspector Ful Mia of Gopalganj Sadar Police Station, were injured in the incident, said Bangladesh Police Officer-in-Charge (OC) Mohammad Aminul Islam. The incident took place this afternoon in the Raghunathpur Kheya Ghat area of Gopalganj Sadar upazila. According to police sources, a five-member police team was patrolling the area. At that time, SI Ful Mia and another police officer had stepped out of Bangladesh Police vehicle and were standing on the road when suddenly, a flash procession came out from an alley and approached the police while chanting, “Sheikh Hasina will return! Bangladesh will smile!” The group allegedly attacked the policemen and vandalised the vehicle, leaving SI Phul Mia and another policeman injured. Police were also chased by the people in the procession, police said. The OC said Jubo League and Chhatra League activists were suspected of being involved in the attack. Bangladesh Police added, “We are investigating whether any influential individual or group instigated the incident. Police operations are underway to identify and arrest those involved.”" ;
    cameo:sourceUrl <https://www.thedailystar.net/news/crime-justice/news/2-cops-injured-attack-during-procession-support-al-gopalganj-4306466> ;
    cameo:trigger "attack" ;
    event:articlePublishedDate "Sat, 24 Oct 26 21:49:40 +0600" ;
    event:articleTitle "2 cops injured in attack during procession 'in support of AL' in Gopalganj" ;
    event:eventId "evt_a05c42c8_000" ;
    event:extractionModel "trigger:verb|cameo:rule" ;
    event:sentenceOffset "[0, 1330]"^^xsd:string ;
    prov:generatedAtTime "2026-10-25T04:34:36+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom article:897d98a823353078 .

