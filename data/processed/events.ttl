event:evt_ba5083c7_000 a cameo:Code191,
        cameo:ViolenceEvent ;
    cameo:actor actor:awami_league,
        actor:rab ;
    cameo:code "191" ;
    cameo:confidence "0.7"^^xsd:float ;
    cameo:date "2026-10-24"^^xsd:date ;
    cameo:label "Impose blockade or restrict movement"@en ;
    cameo:location geo1:rangamati ;
    cameo:sourceSentence "A half-day blockade of roads and waterways in Rangamati and Khagrachhari yesterday disrupted transport services as protesters demonstrated against alleged attacks, baton charges and vandalism during Thursday’s blockade at Ujo Bazar in Sajek, Rangamati. Called by the Chhatra Janata Sangram Parishad, the blockade began in the morning and ended at noon. In Rangamati, protesters blocked the Rangamati-Khagrachhari road with logs and set fires at Sapchhari Khamar Para and Kutukchhari Dharmaghar. protesters also brought out a procession from Kutukchhari Half Bazar to Dharmaghar. Vehicular movement on the Rangamati-Khagrachhari road remained suspended throughout the morning, while traffic continued on the Rangamati-Chattogram road despite the blockade in Betbunia. Md Yusuf, joint general secretary of the Rangamati-Chattogram Bus-Minibus Workers Union, said bus services on the Rangamati-Khagrachhari route resumed after noon, although passenger numbers were low. In Khagrachhari, no long-distance buses departed, although some auto-rickshaws operated in the town. Protesters burnt tyres at Chengi Bridge, Swonirbhar and Jorabridge in Guimara, while felled trees blocked the Chattogram-Khagrachhari road at Sapmara. Khagrachhari Sadar Police Station OC Md Kay Kislu said police escorted overnight buses from Dhaka into town. Some vehicles stranded in Ramgarh were instructed to enter Khagrachhari after noon. [Our correspondents from Rangamati and Khagrachhari contributed to this report]" ;
    cameo:sourceUrl <https://www.thedailystar.net/news/crime-justice/news/half-day-blockade-rangamati-khagrachhari-4306786> ;
    cameo:trigger "blockade" ;
    event:articleTitle "Half-day blockade in Rangamati, Khagrachhari" ;
    event:date_raw "yesterday" ;
    event:eventId "evt_ba5083c7_000" ;
    event:extractionModel "trigger:verb|cameo:rule" ;
    event:sentenceOffset "[0, 1491]"^^xsd:string ;
    prov:generatedAtTime "2026-10-25T04:34:35+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom article:2792d8067dfe39bc .

