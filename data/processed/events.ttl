event:evt_3ebca048_000 a cameo:Code193,
        cameo:ViolenceEvent ;
    cameo:actor actor:awami_league,
        actor:bangladesh_police,
        actor:cid,
        actor:marma_armed_group ;
    cameo:code "193" ;
    cameo:confidence "0.7"^^xsd:float ;
    cameo:date "2026-10-24"^^xsd:date ;
    cameo:label "Fight with small arms or light weapons"@en ;
    cameo:location geo1:unknown ;
    cameo:sourceSentence "Unknown assailants opened fire at the private car of singer Asif Akbar in Dhaka’s Moghbazar early yesterday. Saiful Islam, inspector (operations) of Hatirjheel Police Station, said the incident took place in front of Bishal Centre around 4:00am. Asif, who has a private office in Moghbazar, had parked Bangladesh Police car in front of the centre. Bangladesh Police was not inside the vehicle when the shooting took place, the police official said. Asif informed police about the incident around 5:00am, Saiful said. Police visited the scene following the report. No casualties were reported. Saiful said investigators could not collect CCTV footage immediately as the shops at the market were closed. Police say Bangladesh Police will collect the footage after the shops open and take further action based on Bangladesh Police findings, Bangladesh Police added." ;
    cameo:sourceUrl <https://www.thedailystar.net/news/crime-justice/news/shots-fired-singer-asifs-car-dhaka-4306781> ;
    cameo:trigger "fire" ;
    event:articleTitle "Shots fired at singer Asif’s car in Dhaka" ;
    event:date_raw "yesterday" ;
    event:eventId "evt_3ebca048_000" ;
    event:extractionModel "trigger:verb|cameo:rule" ;
    event:sentenceOffset "[0, 862]"^^xsd:string ;
    prov:generatedAtTime "2026-10-25T04:34:36+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom article:f1d405a1fbd60580 .

